# Supabase (Project settings → API). The public pair is inlined into the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Anthropic. Chat uses Claude Sonnet, moderation and prompt rewriting use Claude Haiku.
ANTHROPIC_API_KEY=
# Set to 1 to run the whole kid flow without calling any model (local dev, Playwright).
AI_MOCK=

# Image generation: openai | google | mock. Mock draws a placeholder PNG locally.
IMAGE_PROVIDER=mock
IMAGE_API_KEY=
# Optional: regional endpoint, e.g. https://eu.api.openai.com/v1 for EU data residency.
IMAGE_API_BASE_URL=

# 32+ random bytes, used to sign the kid cookie: openssl rand -hex 32
KID_COOKIE_SECRET=

# Public origin of the app, used for the join URL on the projector and gallery links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
